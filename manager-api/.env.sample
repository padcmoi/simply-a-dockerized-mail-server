# manager-api env sample
# Bound on 127.0.0.1 via docker-compose, behind nginx.
# Routes are prefixed `/api/v<n>` (URI versioning, default v1).
#
# ROOT credentials are NEVER in env - they live in docker secrets (.secrets/ on the host).
# install.sh creates and rotates them.

NODE_ENV=development
PORT=3000

CORS_ORIGINS=http://127.0.0.1:8080

DB_HOST=mariadb
DB_PORT=3306
DB_USER=mailuser
DB_PASSWORD=change_me_admin_password
DB_NAME=mailserver

# Auth0 - JWT (RS256) validation via JWKS endpoint. SSO Google supported in Auth0 dashboard.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://manager-api.naskot.fr
AUTH0_ISSUER=https://your-tenant.eu.auth0.com/

# Mail server FQDN - used to build the MX DNS record returned by POST /api/v1/domains
DOMAIN_FQDN=mail.example.com

# Root token lifetimes (credentials themselves live in /run/secrets/, not here)
ROOT_JWT_EXPIRES_IN=15m
ROOT_REFRESH_EXPIRES_IN=7d

# Rate limiting (per IP)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

LOG_LEVEL=info
SWAGGER_ENABLED=true
