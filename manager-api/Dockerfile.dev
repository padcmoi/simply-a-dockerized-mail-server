FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=development
RUN apk add --no-cache tini openssl
RUN corepack enable
COPY package.json pnpm-lock.yaml* VERSION* ./
# service.sh writes VERSION from `git describe --tags --abbrev=0`. The dev
# compose also mounts it, so a new tag shows without rebuilding.
RUN [ -f VERSION ] || echo unknown > VERSION
RUN pnpm install --frozen-lockfile || pnpm install
COPY tsconfig.json nest-cli.json ./
# src/ is provided by volume mount at runtime
EXPOSE 3000
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["pnpm", "start:dev"]
