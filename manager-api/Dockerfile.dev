FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=development
# git: the entrypoint reads the last tag from the repository the compose file
# mounts at /host/.git, so the version is made at every start, not at build.
RUN apk add --no-cache tini openssl git
RUN corepack enable
COPY package.json pnpm-lock.yaml* VERSION* ./
# What service.sh may have written, kept as the fallback the entrypoint reads
# when no repository is mounted. A build without it still succeeds.
RUN [ -f VERSION ] || echo unknown > VERSION
RUN pnpm install --frozen-lockfile || pnpm install
COPY tsconfig.json nest-cli.json ./
COPY docker-entrypoint.sh ./
RUN chmod +x docker-entrypoint.sh
# src/ is provided by volume mount at runtime
EXPOSE 3000
ENTRYPOINT ["/sbin/tini", "--", "/app/docker-entrypoint.sh"]
CMD ["pnpm", "start:dev"]
