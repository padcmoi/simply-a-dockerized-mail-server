{
  "name": "mail-manager-api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json",
    "typecheck:src": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.spec.json",
    "typeorm": "typeorm-ts-node-commonjs",
    "db:create": "typeorm migration:create",
    "db:generate": "pnpm typeorm migration:generate -d src/core/database/data-source.ts",
    "db:migrate": "pnpm typeorm migration:run -d src/core/database/data-source.ts",
    "db:revert": "pnpm typeorm migration:revert -d src/core/database/data-source.ts",
    "db:show": "pnpm typeorm migration:show -d src/core/database/data-source.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@naskot/custom-permission-guard": "file:libs/naskot-custom-permission-guard-1.3.0.tgz",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-ws": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "fast-geoip": "^1.1.88",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.20",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11",
    "@swc/core": "^1.15.43",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.6.0",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3"
  },
  "packageManager": "pnpm@9.15.0"
}
