#!/bin/sh

staged_files=$(git diff --cached --name-only --diff-filter=ACM)

./prettier.sh || true

if [ -n "$staged_files" ]; then
	echo "$staged_files" | xargs -r git add --
fi

if ! git diff --cached --name-only | grep -q '^CHANGELOG.md$'; then
	echo "[FAIL] CHANGELOG.md has no staged changes - update it before committing"
	exit 1
fi

new_changelog_lines() {
	git diff --cached -U0 -- CHANGELOG.md | awk '
    /^@@/ {
      if (n > 0 && !hunk_has_minus) { for (i = 1; i <= n; i++) print plus_lines[i] }
      hunk_has_minus = 0; n = 0; next
    }
    /^\+\+\+/ { next }
    /^---/ { next }
    /^-/ { hunk_has_minus = 1; next }
    /^\+/ { n++; plus_lines[n] = substr($0, 2); next }
    END {
      if (n > 0 && !hunk_has_minus) { for (i = 1; i <= n; i++) print plus_lines[i] }
    }
  '
}

invalid_entry_found=0
while IFS= read -r line; do
	[ -z "$line" ] && continue
	if printf '%s' "$line" | grep -qE '^- (feat|fix|chore|refactor|docs|style|test|perf)(\([^)]+\))?: .+ \([0-9]{2}-[0-9]{2}-[0-9]{4}\)( #[A-Za-z0-9]+)?$'; then
		continue
	fi
	invalid_entry_found=1
	if printf '%s' "$line" | grep -qE '^- (feat|fix|chore|refactor|docs|style|test|perf)(\([^)]+\))?: .+' &&
		! printf '%s' "$line" | grep -qE '\([0-9]{2}-[0-9]{2}-[0-9]{4}\)( #[A-Za-z0-9]+)?$'; then
		echo "[FAIL] you forgot the date on this CHANGELOG.md line: $line"
	else
		echo "[FAIL] invalid CHANGELOG.md entry: $line"
	fi
done <<EOF
$(new_changelog_lines)
EOF

if [ "$invalid_entry_found" = "1" ]; then
	exit 1
fi
