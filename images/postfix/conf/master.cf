# =============================================================================
# Postfix master.cf
# =============================================================================
# service  type  private  unpriv  chroot  wakeup  maxproc  command

# Public SMTP (25) fronted by postscreen for early DNSBL drops
smtp        inet  n       -       n       -       1       postscreen
smtpd       pass  -       -       n       -       -       smtpd
dnsblog     unix  -       -       n       -       0       dnsblog
tlsproxy    unix  -       -       n       -       0       tlsproxy

# Implicit TLS (465)
smtps       inet  n       -       n       -       -       smtpd
  -o syslog_name=postfix/smtps
  -o smtpd_tls_wrappermode=yes
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o cleanup_service_name=cleanup

# Submission (587) with STARTTLS
submission  inet  n       -       n       -       -       smtpd
  -o syslog_name=postfix/submission
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject
  -o cleanup_service_name=cleanup

# Internal relay for sieve reject/redirect/vacation bounces from dovecot.
# Bound on the docker bridge only, no milters, no RBL, no SPF, no content
# filtering. Accepts mail strictly from mynetworks (the 172.200.0.0/24 net).
10025       inet  n       -       n       -       -       smtpd
  -o syslog_name=postfix/internal-relay
  -o smtpd_milters=
  -o non_smtpd_milters=
  -o receive_override_options=no_milters,no_header_body_checks,no_unknown_recipient_checks
  -o smtpd_helo_restrictions=
  -o smtpd_sender_restrictions=permit_mynetworks,reject
  -o smtpd_recipient_restrictions=permit_mynetworks,reject
  -o smtpd_relay_restrictions=permit_mynetworks,reject
  -o smtpd_client_restrictions=permit_mynetworks,reject
  -o smtpd_data_restrictions=
  -o smtpd_sasl_auth_enable=no
  -o cleanup_service_name=cleanup

pickup      unix  n       -       n       60      1       pickup
cleanup     unix  n       -       n       -       0       cleanup
qmgr        unix  n       -       n       300     1       qmgr
tlsmgr      unix  -       -       n       1000?   1       tlsmgr
rewrite     unix  -       -       n       -       -       trivial-rewrite
bounce      unix  -       -       n       -       0       bounce
defer       unix  -       -       n       -       0       bounce
trace       unix  -       -       n       -       0       bounce
verify      unix  -       -       n       -       1       verify
flush       unix  n       -       n       1000?   0       flush
proxymap    unix  -       -       n       -       -       proxymap
proxywrite  unix  -       -       n       -       1       proxymap
smtp        unix  -       -       n       -       -       smtp
relay       unix  -       -       n       -       -       smtp
showq       unix  n       -       n       -       -       showq
error       unix  -       -       n       -       -       error
retry       unix  -       -       n       -       -       error
discard     unix  -       -       n       -       -       discard
local       unix  -       n       n       -       -       local
virtual     unix  -       n       n       -       -       virtual
lmtp        unix  -       -       n       -       -       lmtp
anvil       unix  -       -       n       -       1       anvil
scache      unix  -       -       n       -       1       scache
postlog     unix-dgram n   -       n       -       1       postlogd

# Policyd-spf (Alpine package postfix-policyd-spf-perl)
policyd-spf unix  -       n       n       -       0       spawn
  user=nobody argv=/usr/bin/postfix-policyd-spf-perl
