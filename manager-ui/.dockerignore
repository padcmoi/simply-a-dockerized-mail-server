# What the image builds from is the source, not this working directory. Without
# this file `COPY . .` shipped node_modules (half a gigabyte), and it ran AFTER
# `pnpm install`, so the modules installed in the image were overwritten by the
# ones lying here: the production build depended on the state of a developer's
# folder.
node_modules

# Rebuilt by `nuxt build` inside the image. Copying them in hands the build a
# tree generated by another machine, another Node, another mode.
.nuxt
.output
.data
.nitro
.cache

# Nothing the build reads: the tests, the linter and git history are not part of
# the server that is shipped.
test
coverage
.git
.gitignore
*.log
