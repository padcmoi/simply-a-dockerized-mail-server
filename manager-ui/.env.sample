# manager-ui env sample - SPA mode behind nginx
# Public URL of manager-api (the reverse proxy may rewrite this)
NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4003/api/v1

# Auth0 - same tenant as manager-api, but the SPA Application (different from the API Application)
NUXT_PUBLIC_AUTH0_DOMAIN=your-tenant.eu.auth0.com
NUXT_PUBLIC_AUTH0_CLIENT_ID=your_spa_client_id
NUXT_PUBLIC_AUTH0_AUDIENCE=https://manager-api.naskot.fr
