# =============================================================================
# Simply Mail Server v2 - environment template
# Copy to .env then run ./install.sh
# =============================================================================

# Public FQDN, must match PTR / HELO / TLS cert CN.
MAIL_HOSTNAME=mail.example.com

# Public IPv4 reachable by remote MTAs (used for SPF / Received hint).
MAIL_PUBLIC_IP=203.0.113.10

# Where docker volumes live (absolute path or relative to repo).
VOLUMES_PATH=./volumes

# Host LE root (read-only bind mount).
TLS_LETSENCRYPT_PATH=/etc/letsencrypt

# Cert name under /etc/letsencrypt/live/ used by postfix / dovecot.
TLS_CERT_NAME=mail.example.com

# -----------------------------------------------------------------------------
# Databases
# -----------------------------------------------------------------------------
DB_NAME=mailserver
DB_USER=mailserver
DB_PASSWORD=change_me_db_password
DB_ROOT_PASSWORD=change_me_root_password

# -----------------------------------------------------------------------------
# Anti-spam
# -----------------------------------------------------------------------------
RSPAMD_PASSWORD=change_me_rspamd_password

# -----------------------------------------------------------------------------
# DMARC
# -----------------------------------------------------------------------------
DMARC_REJECT_FAILURES=false
DMARC_REPORT_HOUR=2

# -----------------------------------------------------------------------------
# Fail2ban
# -----------------------------------------------------------------------------
FAIL2BAN_MAXRETRY=5
FAIL2BAN_FINDTIME=300
FAIL2BAN_BANTIME=3600

# -----------------------------------------------------------------------------
# manager-api (NestJS) JWT secrets
# -----------------------------------------------------------------------------
MANAGER_JWT_ACCESS_SECRET=change_me_jwt_access
MANAGER_JWT_REFRESH_SECRET=change_me_jwt_refresh
MANAGER_JWT_ACCESS_TTL=900
MANAGER_JWT_REFRESH_TTL=2592000
MANAGER_API_PORT=3000

MANAGER_ADMIN_USERNAME=admin
MANAGER_ADMIN_PASSWORD=change_me_admin_password

# -----------------------------------------------------------------------------
# Host port bindings
#
# Each service exposes a BINDING_PORT_<SERVICE> (the published port) and a
# BINDING_IP_<SERVICE> (the host interface). Set the binding IP to 0.0.0.0 to
# expose the service publicly; keep 127.0.0.1 (default) to make it reachable
# only from the host (e.g. for a host nginx to proxy).
# -----------------------------------------------------------------------------
BINDING_PORT_SMTP=25
BINDING_IP_SMTP=0.0.0.0

BINDING_PORT_SMTPS=465
BINDING_IP_SMTPS=0.0.0.0

BINDING_PORT_SUBMISSION=587
BINDING_IP_SUBMISSION=0.0.0.0

BINDING_PORT_IMAPS=993
BINDING_IP_IMAPS=0.0.0.0

BINDING_PORT_MANAGEUI=51239
BINDING_IP_MANAGEUI=127.0.0.1

BINDING_PORT_ROUNDCUBE=51240
BINDING_IP_ROUNDCUBE=127.0.0.1

BINDING_PORT_RSPAMD_UI=51241
BINDING_IP_RSPAMD_UI=127.0.0.1

BINDING_PORT_PHPMYADMIN=51242
BINDING_IP_PHPMYADMIN=127.0.0.1
