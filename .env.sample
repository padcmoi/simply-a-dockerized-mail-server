#
# v2.0.0 - environment variables
# Copy to .env, fill the values, then run ./install.sh
#

#
# REQUIRED - host wiring
#

# Where the docker volumes live on the host (relative or absolute)
DOCKER_VOLUMES=./volumes

# FQDN of the mail server. This is what postfix announces as HELO/EHLO ; it MUST
# match the reverse DNS (PTR) of the public IP, otherwise Gmail/Outlook spam.
DOMAIN_FQDN=mail.example.com

# Public IPv4 of the docker host (used by extra_hosts inside containers and by
# the SPF records you publish at the DNS provider).
ADRESSIP=203.0.113.10

# Password for the `mailuser` MySQL user, the Rspamd controller, and the
# Roundcube DB connection. 12+ chars with upper, lower and digit. Generate one
# with : openssl rand -base64 24 | tr -d '/+='
ADMIN_PASSWORD=ChangeThisStrongPass1

#
# OpenDKIM
#

# Sign with multiple selectors when the domain has multiple keys (rotation).
DKIM_MULTIPLE_SIGNATURES=yes

# Reject inbound mail that lacks a valid DKIM signature.
DKIM_MUST_BE_SIGNED=no

#
# DMARC
#

# OpenDMARC or RSPAMD (case sensitive). Only OpenDMARC spawns a real container ;
# enable it via : ./service.sh enable opendmarc
DMARC_SELECT=OpenDMARC

# Master switch for the opendmarc milter wiring in postfix.
DMARC_ENABLE=false

# Address that receives DMARC aggregate reports for domains hosted here.
# Leave empty if you don't want to collect reports yourself.
DMARC_REPORTS=

# AuthservID for opendmarc (the identity it stamps in Authentication-Results
# headers). Usually = DOMAIN_FQDN.
DMARC_DOMAIN=

# Friendly name embedded in outbound aggregate reports.
DMARC_ORG_NAME=Example Org

# When true, opendmarc sends aggregate reports to remote rua= endpoints daily.
# Most operators leave this off and only consume incoming reports.
DMARC_ENABLE_REPORT_SENDING=false
DMARC_REPORT_HOUR=2

# Drop messages that fail DMARC (instead of just tagging them).
DMARC_REJECT_FAILURES=false

#
# Antivirus
#
# 0 = disabled, 1 = local clamav container (enable the `clamav` profile too),
# 2 = remote clamav server at ANTIVIRUS_REMOTE_SERVER.
ANTIVIRUS=0
ANTIVIRUS_REMOTE_SERVER=127.0.0.1:3310

#
# Postscreen
#
# Deep protocol tests catch sloppy spammers but cost a 30s delay on first
# connection from each IP. Disable if you front the MX with a fast warmup.
DISABLE_POSTCREEN_DEEP_PROTOCOL_TESTS=false

#
# Spam reject notification
#
NOTIFY_SPAM_REJECT=false
NOTIFY_SPAM_REJECT_TO=

#
# Fail2ban
#
FAIL2BAN_MAXRETRY=5
FAIL2BAN_FINDTIME=300
FAIL2BAN_BANTIME=3600

#
# Postfix logs : true = dedicated postfix.log, false = host syslog
#
POSTFIX_PRIVATE_LOGS=false

#
# manager-api - Auth0 (optional)
#
# Filled from your Auth0 tenant if you want SSO (Google / GitHub / SAML, MFA,
# refresh tokens delegated). manager-api only VALIDATES Auth0 JWTs against the
# JWKS endpoint, no shared secret to manage. Leave empty to disable Auth0 ;
# local root login (via .secrets/ + Accounts table) keeps working.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_ISSUER=
