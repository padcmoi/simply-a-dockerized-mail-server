# =============================================================================
# Simply Mail Server v2 - environment template
# Copy to .env then run ./install.sh
# =============================================================================

# Public FQDN, must match PTR / HELO / TLS cert CN.
MAIL_HOSTNAME=mail.example.com

# Public IPv4 reachable by remote MTAs (used for SPF / Received hint).
MAIL_PUBLIC_IP=203.0.113.10

# Where docker volumes live (absolute path or relative to repo).
VOLUMES_PATH=./volumes

# Host LE root (read-only bind mount).
TLS_LETSENCRYPT_PATH=/etc/letsencrypt

# Cert name under /etc/letsencrypt/live/ used by postfix / dovecot.
TLS_CERT_NAME=mail.example.com

# -----------------------------------------------------------------------------
# Databases
# -----------------------------------------------------------------------------
DB_NAME=mailserver
DB_USER=mailserver
DB_PASSWORD=change_me_db_password
DB_ROOT_PASSWORD=change_me_root_password

# -----------------------------------------------------------------------------
# Anti-spam
# -----------------------------------------------------------------------------
RSPAMD_PASSWORD=change_me_rspamd_password

# -----------------------------------------------------------------------------
# DMARC
# -----------------------------------------------------------------------------
DMARC_REJECT_FAILURES=false
DMARC_REPORT_HOUR=2

# -----------------------------------------------------------------------------
# Fail2ban
# -----------------------------------------------------------------------------
FAIL2BAN_MAXRETRY=5
FAIL2BAN_FINDTIME=300
FAIL2BAN_BANTIME=3600

# -----------------------------------------------------------------------------
# manager-api (NestJS) JWT secrets
# -----------------------------------------------------------------------------
MANAGER_JWT_ACCESS_SECRET=change_me_jwt_access
MANAGER_JWT_REFRESH_SECRET=change_me_jwt_refresh
MANAGER_JWT_ACCESS_TTL=900
MANAGER_JWT_REFRESH_TTL=2592000
MANAGER_API_PORT=3000

# Log every websocket subscribe/unsubscribe (core/websocket). Off by default.
MANAGER_WS_LOG=false

# The first (root) account's email + password are asked interactively by
# install.sh at seed time and kept only in memory -- deliberately NOT stored
# here, so no admin credential ever lingers in .env on disk.

# HMAC-SHA256 pepper for API token hashing. Must not change after first token is created.
MANAGER_API_TOKEN_PEPPER=change_me_api_token_pepper

# Public URL of the manager-ui (used in invitation email links).
MANAGER_UI_URL=https://mail.example.com:51239

# Minimum delay between two notification emails to the same account, in ms.
# Guards against a busy ticket turning into a mail flood (and the server being
# flagged as a spammer). The in-app notification is never throttled. Default 30000.
MANAGER_NOTIFICATION_EMAIL_INTERVAL_MS=30000

# SMTP relay for outbound invitation emails (defaults to postfix container).
# MANAGER_SMTP_HOST=mail-postfix
# MANAGER_SMTP_PORT=25
# MANAGER_SMTP_FROM=noreply@mail.example.com

# -----------------------------------------------------------------------------
# Roundcube default language (used for new mailboxes; existing users keep
# their per-account choice). Use a standard locale code (en_US, fr_FR, de_DE...)
# -----------------------------------------------------------------------------
ROUNDCUBE_LANGUAGE=en_US

# -----------------------------------------------------------------------------
# Maximum attachment size in megabytes. Applied uniformly to:
#  - postfix message_size_limit (full message including headers and base64
#    overhead; raw attachment is ~75% of this value)
#  - Roundcube PHP upload_max_filesize / post_max_size
# Default 25 MB matches Gmail's send limit, which is the practical ceiling
# since most public providers reject anything larger anyway.
# -----------------------------------------------------------------------------
ATTACHMENT_MAX_SIZE_MB=25

# -----------------------------------------------------------------------------
# Host port bindings
#
# Each service exposes a BINDING_PORT_<SERVICE> (the published port) and a
# BINDING_IP_<SERVICE> (the host interface). Set the binding IP to 0.0.0.0 to
# expose the service publicly; keep 127.0.0.1 (default) to make it reachable
# only from the host (e.g. for a host nginx to proxy).
# -----------------------------------------------------------------------------
BINDING_PORT_SMTP=25
BINDING_IP_SMTP=0.0.0.0

BINDING_PORT_SMTPS=465
BINDING_IP_SMTPS=0.0.0.0

BINDING_PORT_SUBMISSION=587
BINDING_IP_SUBMISSION=0.0.0.0

BINDING_PORT_IMAPS=993
BINDING_IP_IMAPS=0.0.0.0

BINDING_PORT_MANAGEUI=51239
BINDING_IP_MANAGEUI=127.0.0.1

BINDING_PORT_ROUNDCUBE=51240
BINDING_IP_ROUNDCUBE=127.0.0.1

BINDING_PORT_RSPAMD_UI=51241
BINDING_IP_RSPAMD_UI=127.0.0.1

BINDING_PORT_PHPMYADMIN=51242
BINDING_IP_PHPMYADMIN=127.0.0.1

BINDING_PORT_WS=51243
BINDING_IP_WS=127.0.0.1
