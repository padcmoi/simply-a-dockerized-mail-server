#
# v2.0.0 - environment variables
# Same vars as 1.x.x for compat surface ; INSTALLATION.sh consumes this file
#

#
# Required
#

# Volumes root (relative to v2/ or absolute)
DOCKER_VOLUMES=./volumes

# FQDN of the mail server
DOMAIN_FQDN=docker.naskot.fr

# Public IP of the docker host (used for extra_hosts inside containers)
ADRESSIP=51.68.127.3

# Admin password (used as mailuser MySQL password + Rspamd controller + future webadmin)
# 12 chars min, must include upper/lower/digit
ADMIN_PASSWORD=change_me_strong_password_12chars

#
# OpenDKIM
#
DKIM_MULTIPLE_SIGNATURES=yes
DKIM_MUST_BE_SIGNED=no

#
# DMARC
#
# OpenDMARC or RSPAMD (case sensitive). Only OpenDMARC actually spawns a container in v2.
DMARC_SELECT=OpenDMARC
DMARC_ENABLE=false
DMARC_REPORTS=
DMARC_DOMAIN=
DMARC_ORG_NAME=Naskot Mail
DMARC_ENABLE_REPORT_SENDING=false
DMARC_REPORT_HOUR=2
DMARC_REJECT_FAILURES=false

#
# Antivirus (0=disabled, 1=enabled local, 2=remote)
#
ANTIVIRUS=0
ANTIVIRUS_REMOTE_SERVER=127.0.0.1:3310

#
# Postscreen
#
DISABLE_POSTCREEN_DEEP_PROTOCOL_TESTS=false

#
# Spam reject notification
#
NOTIFY_SPAM_REJECT=false
NOTIFY_SPAM_REJECT_TO=

#
# Fail2ban
#
FAIL2BAN_MAXRETRY=5
FAIL2BAN_FINDTIME=300
FAIL2BAN_BANTIME=3600

#
# Postfix logs (true = postfix.log, false = syslog)
#
POSTFIX_PRIVATE_LOGS=false
